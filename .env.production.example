# ═══════════════════════════════════════════════════
# GloboAtlas — Production Environment Variables
# ═══════════════════════════════════════════════════
# ВАЖНО: Сгенерируйте уникальные пароли!
# Используйте: openssl rand -base64 32

# ── Database ──────────────────────────────────────
DB_USER=globoatlas
DB_PASSWORD=CHANGE_ME_USE_openssl_rand_base64_32

# ── JWT ───────────────────────────────────────────
# Секрет для подписи токенов (минимум 32 символа)
JWT_SECRET=CHANGE_ME_USE_openssl_rand_base64_64

# ── MinIO (Object Storage) ────────────────────────
MINIO_USER=globoatlas-minio
MINIO_PASSWORD=CHANGE_ME_USE_openssl_rand_base64_32

# ── CORS ──────────────────────────────────────────
# Укажите ваш реальный домен
CORS_ORIGINS=https://your-domain.ru

# ── Web (build-time) ─────────────────────────────
# URL API для клиентского кода Next.js
NEXT_PUBLIC_API_URL=https://your-domain.ru

# ── Public app URL ───────────────────────────────
# Куда ведут ссылки из писем (домен фронта)
PUBLIC_APP_URL=https://your-domain.ru

# ── SMTP (Email отправка приглашений) ────────────
# Yandex 360 пример:
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@your-domain.ru
SMTP_PASS=CHANGE_ME_yandex_app_password
SMTP_FROM=ГлобоАтлас <noreply@your-domain.ru>
