# ═══════════════════════════════════════════════════
# GloboAtlas — Production Environment Variables
# ═══════════════════════════════════════════════════
# ВАЖНО: Сгенерируйте уникальные секреты!
#
# Генерация:
#   JWT_SECRET     → openssl rand -base64 48
#   все пароли     → openssl rand -hex 32
#
# Файл должен иметь права 600:  chmod 600 .env
# НИКОГДА не коммитить файл `.env` (он в .gitignore)

# ── Database ─────────────────────────────────────────
DB_USER=globoatlas
DB_PASSWORD=CHANGE_ME_USE_openssl_rand_hex_32

# ── JWT ──────────────────────────────────────────────
# Подписывает access/refresh-токены и invite-ссылки.
JWT_SECRET=CHANGE_ME_USE_openssl_rand_base64_48

# ── Object Storage (SeaweedFS — S3-совместимый) ──────
# Env-переменные оставлены с префиксом MINIO_ для обратной
# совместимости с кодом — фактически работает через SeaweedFS S3 API.
MINIO_USER=globoatlas-storage
MINIO_PASSWORD=CHANGE_ME_USE_openssl_rand_hex_32

# ── CORS ─────────────────────────────────────────────
# Укажите реальный домен (или несколько через запятую).
CORS_ORIGINS=https://your-domain.ru

# ── Web (build-time) ─────────────────────────────────
# Корневой URL приложения (без /api в конце — фронт сам добавит).
# Эти переменные NEXT_PUBLIC_* вшиваются в бандл на этапе build,
# поэтому при их изменении нужен ребилд web-контейнера.
NEXT_PUBLIC_API_URL=https://your-domain.ru
NEXT_PUBLIC_WS_URL=https://your-domain.ru

# ── Public app URL ───────────────────────────────────
# Куда ведут ссылки из writeм-приглашений и сброса пароля.
PUBLIC_APP_URL=https://your-domain.ru

# ── SMTP (email-приглашения и сброс пароля) ──────────
# Пример Yandex 360:
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@your-domain.ru
SMTP_PASS=CHANGE_ME_yandex_app_password
SMTP_FROM=ГлобоАтлас <noreply@your-domain.ru>

# ── AI (опционально) ─────────────────────────────────
# Оставьте stub, если нет своей AI-инстанции.
# Поддерживаются OpenAI-совместимые endpoint'ы (vLLM, Ollama, LM Studio).
AI_PROVIDER=stub
AI_API_URL=
AI_API_KEY=
AI_MODEL=

# ── Sentry (опционально, осторожно с ПДн!) ───────────
# Sentry серверы в EU/US — трансграничная передача ПДн.
# Перед включением: настроить scrubbing, согласовать с юристом.
# Если оставить пусто — Sentry будет no-op.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_TRACES_RATE=0.05

# ── Health-monitoring (внешнее) ──────────────────────
# UptimeRobot / BetterStack пингуют /api/health — ничего здесь не нужно.
# APP_VERSION читается health-эндпоинтом и Sentry — обычно ставится в CI.
APP_VERSION=prod
