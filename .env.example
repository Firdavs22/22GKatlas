# ====== Database ======
DB_USER=globoatlas
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ====== JWT (use: openssl rand -base64 48) ======
JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING

# ====== MinIO object storage ======
MINIO_USER=minioadmin
MINIO_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ====== CORS / API URLs ======
# In production set this to your domain, e.g. https://kindergarten.example.com
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Public API URL the browser hits. In production it is your domain + /api
# Example: NEXT_PUBLIC_API_URL=https://kindergarten.example.com/api
NEXT_PUBLIC_API_URL=
