# ====== Database ======
DB_USER=globoatlas
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ====== JWT (use: openssl rand -base64 48) ======
JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING

# ====== SeaweedFS S3-compatible object storage ======
# Env names are kept as MINIO_* because the backend uses the minio npm SDK as an S3 client.
MINIO_USER=minioadmin
MINIO_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ====== CORS / API URLs ======
# In production set this to your domain, e.g. https://kindergarten.example.com
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Public API URL the browser hits. In production it is your domain + /api
# Example: NEXT_PUBLIC_API_URL=https://kindergarten.example.com/api
NEXT_PUBLIC_API_URL=

# ====== Public app URL (used in email links) ======
# Where parents will land when clicking the invite link. Must match the frontend host.
# Example: https://kindergarten.example.com
PUBLIC_APP_URL=http://localhost:3000

# ====== SMTP (email отправка приглашений) ======
# Оставь пустым SMTP_HOST в dev — письма будут только логироваться в консоль.
# Для Yandex 360 заполни так:
#   SMTP_HOST=smtp.yandex.ru
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=noreply@yourdomain.ru
#   SMTP_PASS=<пароль приложения из Яндекс ID, не пароль от почты>
#   SMTP_FROM="ГлобоАтлас <noreply@yourdomain.ru>"
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ====== AI (генерация описаний наблюдений) ======
# Оставь AI_PROVIDER пустым или 'stub' — будет работать детерминированный шаблон без AI.
# Когда подключишь Gemma (или другой OpenAI-совместимый эндпоинт):
#   AI_PROVIDER=gemma
#   AI_API_URL=http://your-gpu-host:8000/v1   (vLLM / Ollama / llama.cpp в OpenAI-режиме)
#   AI_API_KEY=                                (если эндпоинт требует ключ, иначе пусто)
#   AI_MODEL=gemma-2-9b-it                     (или другое имя модели)
AI_PROVIDER=stub
AI_API_URL=
AI_API_KEY=
AI_MODEL=
