# ====== Database ======
DB_USER=globoatlas
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ====== JWT (use: openssl rand -base64 48) ======
JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING

# ====== MinIO object storage ======
MINIO_USER=minioadmin
MINIO_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ====== CORS / API URLs ======
# In production set this to your domain, e.g. https://kindergarten.example.com
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Public API URL the browser hits. In production it is your domain + /api
# Example: NEXT_PUBLIC_API_URL=https://kindergarten.example.com/api
NEXT_PUBLIC_API_URL=

# ====== Public app URL (used in email links) ======
# Where parents will land when clicking the invite link. Must match the frontend host.
# Example: https://kindergarten.example.com
PUBLIC_APP_URL=http://localhost:3000

# ====== SMTP (email отправка приглашений) ======
# Оставь пустым SMTP_HOST в dev — письма будут только логироваться в консоль.
# Для Yandex 360 заполни так:
#   SMTP_HOST=smtp.yandex.ru
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=noreply@yourdomain.ru
#   SMTP_PASS=<пароль приложения из Яндекс ID, не пароль от почты>
#   SMTP_FROM="ГлобоАтлас <noreply@yourdomain.ru>"
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
