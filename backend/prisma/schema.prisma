generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── DIRECTORY ────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role
  avatar    String?
  createdAt DateTime @default(now())

  teacherGroup       Group?            @relation("GroupTeacher")
  parentChildren     ChildParent[]
  specialistChildren ChildSpecialist[]
  observations       Observation[]
  portfolioItems     PortfolioItem[]
  sentMessages       ChatMessage[]
  feedItems          FeedItem[]
  notifications      Notification[]
  specialistNotes    SpecialistNote[]
  menus              Menu[]
  events             Event[]
  broadcasts         Broadcast[]
  feedLikes          FeedLike[]
}

enum Role {
  admin
  teacher
  parent
  psychologist
  pediatrician
}

model Child {
  id              String      @id @default(uuid())
  name            String
  birthDate       DateTime
  photo           String?
  enrolledAt      DateTime    @default(now())
  status          ChildStatus @default(active)
  externalId      String?
  contacts        Json?       // [{name, phone, relation}]
  representatives Json?       // [{name, phone, relation}]
  extraServices   String[]    @default([])
  allergies       String?
  documents       Json?       // {medCard: bool, birthCert: bool, ...}
  notes           String?
  createdAt       DateTime    @default(now())

  group           Group?            @relation(fields: [groupId], references: [id])
  groupId         String?
  parents         ChildParent[]
  specialists     ChildSpecialist[]
  progress        Progress[]
  observations    Observation[]
  portfolioItems  PortfolioItem[]
  attendance      Attendance[]
  payments        Payment[]
  homeTasks       HomeTask[]
  specialistNotes SpecialistNote[]
  feedItems       FeedItem[]
}

enum ChildStatus {
  active
  graduated
  left
}

model Group {
  id         String   @id @default(uuid())
  name       String
  ageRange   String
  year       Int
  capacity   Int      @default(24)
  monthlyFee Float    @default(75000)
  externalId String?

  teacher   User?      @relation("GroupTeacher", fields: [teacherId], references: [id])
  teacherId String?    @unique
  children  Child[]
  schedules Schedule[]
  feedItems FeedItem[]
}

model ChildParent {
  child    Child  @relation(fields: [childId], references: [id])
  childId  String
  parent   User   @relation(fields: [parentId], references: [id])
  parentId String

  @@id([childId, parentId])
}

model ChildSpecialist {
  child        Child  @relation(fields: [childId], references: [id])
  childId      String
  specialist   User   @relation(fields: [specialistId], references: [id])
  specialistId String
  role         Role

  @@id([childId, specialistId])
}

model Attendance {
  id      String           @id @default(uuid())
  child   Child            @relation(fields: [childId], references: [id])
  childId String
  date    DateTime
  status  AttendanceStatus

  @@unique([childId, date])
}

enum AttendanceStatus {
  present
  sick
  vacation
  absent
}

model Payment {
  id      String        @id @default(uuid())
  child   Child         @relation(fields: [childId], references: [id])
  childId String
  month   DateTime
  amount  Float
  paid    Float         @default(0)
  status  PaymentStatus @default(pending)
}

enum PaymentStatus {
  paid
  pending
  overdue
}

// ─── PROGRESS MATRIX ──────────────────────────────────────

model Area {
  id        String       @id @default(uuid())
  title     String
  icon      String
  color     String
  sortOrder Int
  groups    SkillGroup[]
}

model SkillGroup {
  id        String   @id @default(uuid())
  title     String
  area      Area     @relation(fields: [areaId], references: [id])
  areaId    String
  sortOrder Int
  skills    Skill[]
}

model Skill {
  id          String     @id @default(uuid())
  title       String
  description String?
  ageRange    String?
  sortOrder   Int
  group       SkillGroup @relation(fields: [groupId], references: [id])
  groupId     String
  progress    Progress[]
  homeTasks   HomeTask[]
}

model Progress {
  id          String            @id @default(uuid())
  child       Child             @relation(fields: [childId], references: [id])
  childId     String
  skill       Skill             @relation(fields: [skillId], references: [id])
  skillId     String
  stage       ProgressStage     @default(none)
  updatedAt   DateTime          @updatedAt
  updatedById String?
  history     ProgressHistory[]

  @@unique([childId, skillId])
}

enum ProgressStage {
  none
  presented
  practicing
  mastered
}

model ProgressHistory {
  id         String        @id @default(uuid())
  progress   Progress      @relation(fields: [progressId], references: [id])
  progressId String
  oldStage   ProgressStage
  newStage   ProgressStage
  note       String?
  changedAt  DateTime      @default(now())
  changedBy  String?
}

// ─── OBSERVATIONS ─────────────────────────────────────────

model Observation {
  id        String   @id @default(uuid())
  child     Child    @relation(fields: [childId], references: [id])
  childId   String
  author    User     @relation(fields: [userId], references: [id])
  userId    String
  text      String
  areaId    String?
  tags      String[]
  photos    String[]
  visible   Boolean  @default(false)
  date      DateTime @default(now())
  createdAt DateTime @default(now())
}

// ─── PORTFOLIO ────────────────────────────────────────────

model PortfolioItem {
  id          String   @id @default(uuid())
  child       Child    @relation(fields: [childId], references: [id])
  childId     String
  author      User     @relation(fields: [authorId], references: [id])
  authorId    String
  type        String
  title       String
  description String?
  fileUrl     String
  areaId      String?
  date        DateTime @default(now())
}

// ─── FEED (Лента) ─────────────────────────────────────────

model FeedItem {
  id        String       @id @default(uuid())
  type      FeedItemType
  scope     FeedScope

  author    User         @relation(fields: [authorId], references: [id])
  authorId  String

  child     Child?       @relation(fields: [childId], references: [id])
  childId   String?

  group     Group?       @relation(fields: [groupId], references: [id])
  groupId   String?

  title     String?
  text      String?
  mediaUrls String[]
  pinned    Boolean      @default(false)

  createdAt DateTime     @default(now())
  likes     FeedLike[]
}

model FeedLike {
  feedItem   FeedItem @relation(fields: [feedItemId], references: [id], onDelete: Cascade)
  feedItemId String
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  createdAt  DateTime @default(now())

  @@id([feedItemId, userId])
}

enum FeedItemType {
  child_photo
  child_achievement
  group_news
  school_news
  menu
  event
}

enum FeedScope {
  child
  group
  school
}

// ─── SPECIALIST NOTES ─────────────────────────────────────

model SpecialistNote {
  id              String         @id @default(uuid())
  child           Child          @relation(fields: [childId], references: [id])
  childId         String
  specialist      User           @relation(fields: [specialistId], references: [id])
  specialistId    String
  type            NoteType
  text            String
  recommendations String?
  visibility      NoteVisibility @default(specialist_only)
  attachments     String[]
  createdAt       DateTime       @default(now())
}

enum NoteType {
  observation
  diagnosis
  recommendation
  plan
  checkup
  referral
  vaccination
}

enum NoteVisibility {
  specialist_only
  with_teacher
  with_parent
}

// ─── CHATS ────────────────────────────────────────────────

model ChatRoom {
  id           String            @id @default(uuid())
  type         ChatType
  childId      String?
  participants ChatParticipant[]
  messages     ChatMessage[]
}

enum ChatType {
  teacher_parent
  pediatrician_parent
  teacher_psychologist
  admin_parent
  psychologist_parent
}

model ChatParticipant {
  chatRoom   ChatRoom  @relation(fields: [chatRoomId], references: [id])
  chatRoomId String
  userId     String
  lastReadAt DateTime?

  @@id([chatRoomId, userId])
}

model ChatMessage {
  id          String   @id @default(uuid())
  chatRoom    ChatRoom @relation(fields: [chatRoomId], references: [id])
  chatRoomId  String
  sender      User     @relation(fields: [senderId], references: [id])
  senderId    String
  text        String
  attachments String[]
  createdAt   DateTime @default(now())
}

// ─── SCHEDULE ─────────────────────────────────────────────

model Schedule {
  id          String @id @default(uuid())
  group       Group  @relation(fields: [groupId], references: [id])
  groupId     String
  dayOfWeek   Int
  timeStart   String
  timeEnd     String
  activity    String
  description String?
}

// ─── HOME TASKS ───────────────────────────────────────────

model HomeTask {
  id          String         @id @default(uuid())
  child       Child          @relation(fields: [childId], references: [id])
  childId     String
  skill       Skill          @relation(fields: [skillId], references: [id])
  skillId     String
  title       String
  description String?
  status      HomeTaskStatus @default(pending)
}

enum HomeTaskStatus {
  pending
  done
}

// ─── NOTIFICATIONS ────────────────────────────────────────

model Notification {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  type      String
  title     String
  body      String
  read      Boolean  @default(false)
  data      Json?
  createdAt DateTime @default(now())
}

// ─── EVENTS & MENU ─────────────────────────────────────────

model Menu {
  id        String   @id @default(uuid())
  title     String
  content   String
  startDate DateTime
  endDate   DateTime
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  createdAt DateTime @default(now())
}

model Event {
  id          String   @id @default(uuid())
  title       String
  description String?
  eventDate   DateTime
  mediaUrls   String[] @default([])
  author      User     @relation(fields: [authorId], references: [id])
  authorId    String
  createdAt   DateTime @default(now())
}

// ─── BROADCAST (РАССЫЛКА) ─────────────────────────────────

model Broadcast {
  id           String   @id @default(uuid())
  title        String
  message      String
  author       User     @relation(fields: [authorId], references: [id])
  authorId     String
  targetGroups String[] // Array of group IDs, or empty/["all"] for everyone
  sentAt       DateTime @default(now())
}
