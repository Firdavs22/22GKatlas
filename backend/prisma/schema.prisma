generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── DIRECTORY ────────────────────────────────────────────

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  password        String
  name            String
  role            Role
  avatar          String?
  phone           String?
  // Personal-data processing consent (152-ФЗ). Set when invitee accepts terms.
  consentGivenAt  DateTime?
  // Soft-delete marker. Anonymized record kept for FK integrity until 30 days, then physical-delete by cron.
  deletedAt       DateTime?
  // First-time onboarding tour completion. null = show modal on next dashboard view.
  onboardingCompletedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  teacherGroup       Group?            @relation("GroupTeacher")
  parentChildren     ChildParent[]
  specialistChildren ChildSpecialist[]
  observations       Observation[]
  portfolioItems     PortfolioItem[]
  sentMessages       ChatMessage[]
  feedItems          FeedItem[]
  notifications      Notification[]
  specialistNotes    SpecialistNote[]
  menus              Menu[]
  events             Event[]
  broadcasts         Broadcast[]
  feedLikes          FeedLike[]
  refreshTokens      RefreshToken[]
  chatParticipants   ChatParticipant[]
}

enum Role {
  admin
  teacher
  parent
  psychologist
  pediatrician
  superadmin
}

model Child {
  id              String      @id @default(uuid())
  name            String
  birthDate       DateTime
  photo           String?
  enrolledAt      DateTime    @default(now())
  status          ChildStatus @default(active)
  externalId      String?
  contacts        Json?       // [{name, phone, relation}]
  representatives Json?       // [{name, phone, relation}]
  extraServices   String[]    @default([])
  allergies       String?
  documents       Json?       // {medCard: bool, birthCert: bool, ...}
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  group           Group?            @relation(fields: [groupId], references: [id])
  groupId         String?
  parents         ChildParent[]
  specialists     ChildSpecialist[]
  progress        Progress[]
  observations    Observation[]
  portfolioItems  PortfolioItem[]
  attendance      Attendance[]
  payments        Payment[]
  homeTasks       HomeTask[]
  specialistNotes SpecialistNote[]
  feedItems       FeedItem[]
}

enum ChildStatus {
  active
  graduated
  left
}

model Group {
  id         String   @id @default(uuid())
  name       String
  ageRange   String
  year       Int
  capacity   Int      @default(24)
  monthlyFee Float    @default(75000)
  externalId String?

  teacher   User?      @relation("GroupTeacher", fields: [teacherId], references: [id])
  teacherId String?    @unique
  children  Child[]
  schedules Schedule[]
  feedItems FeedItem[]
}

model ChildParent {
  child    Child  @relation(fields: [childId], references: [id])
  childId  String
  parent   User   @relation(fields: [parentId], references: [id])
  parentId String

  @@id([childId, parentId])
}

model ChildSpecialist {
  child        Child  @relation(fields: [childId], references: [id])
  childId      String
  specialist   User   @relation(fields: [specialistId], references: [id])
  specialistId String
  role         Role

  @@id([childId, specialistId])
}

model Attendance {
  id      String           @id @default(uuid())
  child   Child            @relation(fields: [childId], references: [id])
  childId String
  date    DateTime
  status  AttendanceStatus

  @@unique([childId, date])
  @@index([date])
}

enum AttendanceStatus {
  present
  sick
  vacation
  absent
}

model Payment {
  id      String        @id @default(uuid())
  child   Child         @relation(fields: [childId], references: [id])
  childId String
  month   DateTime
  amount  Decimal       @db.Decimal(10, 2)
  paid    Decimal       @default(0) @db.Decimal(10, 2)
  status  PaymentStatus @default(pending)

  @@unique([childId, month])
  @@index([childId, month(sort: Desc)])
}

enum PaymentStatus {
  paid
  pending
  overdue
}

// ─── PROGRESS MATRIX ──────────────────────────────────────

model Area {
  id        String       @id @default(uuid())
  title     String
  icon      String
  color     String
  sortOrder Int
  groups    SkillGroup[]
}

model SkillGroup {
  id        String   @id @default(uuid())
  title     String
  area      Area     @relation(fields: [areaId], references: [id])
  areaId    String
  sortOrder Int
  skills    Skill[]
}

model Skill {
  id                 String     @id @default(uuid())
  title              String
  description        String?
  ageRange           String?
  sortOrder          Int
  group              SkillGroup @relation(fields: [groupId], references: [id])
  groupId            String
  progress           Progress[]
  homeTasks          HomeTask[]
  // Three development dimensions (parent-facing view).
  // One skill can carry multiple flags (e.g. Pink Tower → cognition + body).
  developsEmotion    Boolean    @default(false)
  developsCognition  Boolean    @default(false)
  developsBody       Boolean    @default(false)

  @@index([developsEmotion])
  @@index([developsCognition])
  @@index([developsBody])
}

model Progress {
  id          String            @id @default(uuid())
  child       Child             @relation(fields: [childId], references: [id])
  childId     String
  skill       Skill             @relation(fields: [skillId], references: [id])
  skillId     String
  stage       ProgressStage     @default(none)
  updatedAt   DateTime          @updatedAt
  updatedById String?
  history     ProgressHistory[]

  @@unique([childId, skillId])
}

enum ProgressStage {
  none
  presented
  practicing
  mastered
}

model ProgressHistory {
  id         String        @id @default(uuid())
  progress   Progress      @relation(fields: [progressId], references: [id])
  progressId String
  oldStage   ProgressStage
  newStage   ProgressStage
  note       String?
  changedAt  DateTime      @default(now())
  changedBy  String?

  @@index([progressId, changedAt])
}

// ─── OBSERVATIONS ─────────────────────────────────────────

model Observation {
  id        String   @id @default(uuid())
  child     Child    @relation(fields: [childId], references: [id])
  childId   String
  author    User     @relation(fields: [userId], references: [id])
  userId    String
  title     String?
  text      String
  areaId    String?
  tags      String[]
  photos    String[]
  visible   Boolean  @default(false)
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([childId, date(sort: Desc)])
}

// ─── PORTFOLIO ────────────────────────────────────────────

model PortfolioItem {
  id          String   @id @default(uuid())
  child       Child    @relation(fields: [childId], references: [id])
  childId     String
  author      User     @relation(fields: [authorId], references: [id])
  authorId    String
  type        String
  title       String
  description String?
  fileUrl     String
  areaId      String?
  date        DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([childId, date(sort: Desc)])
}

// ─── FEED (Лента) ─────────────────────────────────────────

model FeedItem {
  id        String       @id @default(uuid())
  type      FeedItemType
  scope     FeedScope

  author    User         @relation(fields: [authorId], references: [id])
  authorId  String

  child     Child?       @relation(fields: [childId], references: [id])
  childId   String?

  group     Group?       @relation(fields: [groupId], references: [id])
  groupId   String?

  title     String?
  text      String?
  mediaUrls String[]
  pinned    Boolean      @default(false)

  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  likes     FeedLike[]

  @@index([groupId, createdAt(sort: Desc)])
  @@index([childId, createdAt(sort: Desc)])
}

model FeedLike {
  feedItem   FeedItem @relation(fields: [feedItemId], references: [id], onDelete: Cascade)
  feedItemId String
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  createdAt  DateTime @default(now())

  @@id([feedItemId, userId])
}

enum FeedItemType {
  child_photo
  child_achievement
  group_news
  school_news
  menu
  event
}

enum FeedScope {
  child
  group
  school
}

// ─── SPECIALIST NOTES ─────────────────────────────────────

model SpecialistNote {
  id              String         @id @default(uuid())
  child           Child          @relation(fields: [childId], references: [id])
  childId         String
  specialist      User           @relation(fields: [specialistId], references: [id])
  specialistId    String
  type            NoteType
  text            String
  recommendations String?
  visibility      NoteVisibility @default(specialist_only)
  attachments     String[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([childId, createdAt(sort: Desc)])
  @@index([specialistId])
}

enum NoteType {
  observation
  diagnosis
  recommendation
  plan
  checkup
  referral
  vaccination
}

enum NoteVisibility {
  specialist_only
  with_teacher
  with_parent
}

// ─── CHATS ────────────────────────────────────────────────

model ChatRoom {
  id           String            @id @default(uuid())
  type         ChatType
  childId      String?
  participants ChatParticipant[]
  messages     ChatMessage[]
}

enum ChatType {
  teacher_parent
  pediatrician_parent
  teacher_psychologist
  admin_parent
  psychologist_parent
}

model ChatParticipant {
  chatRoom   ChatRoom  @relation(fields: [chatRoomId], references: [id])
  chatRoomId String
  user       User      @relation(fields: [userId], references: [id])
  userId     String
  lastReadAt DateTime?

  @@id([chatRoomId, userId])
}

model ChatMessage {
  id          String   @id @default(uuid())
  chatRoom    ChatRoom @relation(fields: [chatRoomId], references: [id])
  chatRoomId  String
  sender      User     @relation(fields: [senderId], references: [id])
  senderId    String
  text        String
  attachments String[]
  createdAt   DateTime @default(now())

  @@index([chatRoomId, createdAt])
}

// ─── SCHEDULE ─────────────────────────────────────────────

model Schedule {
  id          String @id @default(uuid())
  group       Group  @relation(fields: [groupId], references: [id])
  groupId     String
  dayOfWeek   Int
  timeStart   String
  timeEnd     String
  activity    String
  description String?
}

// ─── HOME TASKS ───────────────────────────────────────────

model HomeTask {
  id          String         @id @default(uuid())
  child       Child          @relation(fields: [childId], references: [id])
  childId     String
  skill       Skill?         @relation(fields: [skillId], references: [id])
  skillId     String?
  authorId    String?
  authorRole  String?
  title       String
  description String?
  tags        String[]       @default([])
  status      HomeTaskStatus @default(pending)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

enum HomeTaskStatus {
  pending
  done
}

// ─── NOTIFICATIONS ────────────────────────────────────────

model Notification {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  type      String
  title     String
  body      String
  read      Boolean  @default(false)
  data      Json?
  createdAt DateTime @default(now())

  @@index([userId, read, createdAt(sort: Desc)])
}

// ─── EVENTS & MENU ─────────────────────────────────────────

model Menu {
  id        String   @id @default(uuid())
  title     String
  content   String
  startDate DateTime
  endDate   DateTime
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Event {
  id          String        @id @default(uuid())
  title       String
  description String?
  eventDate   DateTime
  mediaUrls   String[]      @default([])
  audience    EventAudience @default(all)
  groupId     String?
  author      User          @relation(fields: [authorId], references: [id])
  authorId    String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

enum EventAudience {
  all
  parents
  group
  staff
}

// ─── BROADCAST (РАССЫЛКА) ─────────────────────────────────

model Broadcast {
  id           String   @id @default(uuid())
  title        String
  message      String
  author       User     @relation(fields: [authorId], references: [id])
  authorId     String
  targetGroups String[] // Array of group IDs, or empty/["all"] for everyone
  sentAt       DateTime @default(now())
}

// ─── KNOWLEDGE BASE ───────────────────────────────────────

model KbCategory {
  id          String     @id @default(uuid())
  title       String
  slug        String     @unique
  description String?
  order       Int        @default(0)
  articles    KbArticle[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model KbArticle {
  id          String      @id @default(uuid())
  category    KbCategory  @relation(fields: [categoryId], references: [id])
  categoryId  String
  title       String
  excerpt     String?
  body        String
  videoUrl    String?
  coverUrl    String?
  published   Boolean     @default(true)
  authorId    String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([categoryId, createdAt(sort: Desc)])
}

// ─── APPOINTMENT BOOKING ──────────────────────────────────

model AppointmentSlot {
  id           String              @id @default(uuid())
  staffId      String
  startsAt     DateTime
  endsAt       DateTime
  location     String?
  notes        String?
  bookings     AppointmentBooking[]
  createdAt    DateTime            @default(now())

  @@index([staffId, startsAt])
}

model AppointmentBooking {
  id        String           @id @default(uuid())
  slot      AppointmentSlot  @relation(fields: [slotId], references: [id])
  slotId    String           @unique
  parentId  String
  childId   String?
  topic     String?
  status    BookingStatus    @default(confirmed)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([parentId, createdAt(sort: Desc)])
}

enum BookingStatus {
  confirmed
  cancelled
}

// ─── REFRESH TOKENS ───────────────────────────────────────

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  deviceId  String?
  deviceName String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

// Editable site content (texts, logo, etc.) — keyed JSON blobs.
model SiteContent {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// Append-only log of mutating actions by users (admin compliance + breach forensics).
// Populated by AuditInterceptor on every POST/PUT/PATCH/DELETE under /api/.
model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  actorRole String?
  method    String   // POST | PUT | PATCH | DELETE
  path      String   // route, e.g. /admin/staff/123
  status    Int      // HTTP status returned
  ip        String?
  userAgent String?
  // Sanitized request body (passwords stripped). Limited to 4 KB.
  body      Json?
  // Free-form summary set by service when interesting (e.g. "Удалён ребёнок Иванов И.").
  summary   String?
  durationMs Int?
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([path, createdAt])
  @@index([createdAt])
}

// Per-uploaded-file metadata. Used by GET /api/files/:filename to check that
// the requester has access to the resource (otherwise any logged-in user could
// download any file by guessing the UUID).
//
//   scope:
//     'public'    — anyone authenticated (logo, sidebar icon, kb articles)
//     'uploader'  — only the uploader (drafts, in-progress uploads)
//     'child'     — anyone with access to childId (parent, teacher of group,
//                   assigned specialist, admin)
//     'group'     — anyone in groupId (teacher + parents whose child is in group + admin)
//     'school'    — anyone authenticated (school-wide posts/menus/events)
model FileMeta {
  filename   String   @id
  scope      String   // 'public' | 'uploader' | 'child' | 'group' | 'school'
  uploaderId String?
  childId    String?
  groupId    String?
  createdAt  DateTime @default(now())

  @@index([uploaderId])
  @@index([childId])
  @@index([groupId])
}
