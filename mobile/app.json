{
  "expo": {
    "name": "ГлобоАтлас",
    "slug": "globoatlas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "globoatlas",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F5192"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.globokids.atlas"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F5192"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.globokids.atlas"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font"
    ]
  }
}
